{
  "name": "midnight-splitter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "contract:compile": "wsl -d Ubuntu bash -c \"~/.local/bin/compact compile contracts/midnight_splitter.compact dist/contracts\"",
    "contract:deploy": "node scripts/deploy-preprod.mjs",
    "contract:deploy:dry": "node scripts/deploy-preprod.mjs --dry-run",
    "contract:deploy:force": "node scripts/deploy-preprod.mjs --force",
    "contract:verify": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-network-provider": "file:./src/midnight/midnight-js-network-provider",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^2.1.0"
  }
}
