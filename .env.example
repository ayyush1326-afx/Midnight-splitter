# ─── Midnight Splitter — Environment Variables ───────────────────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git — it contains your wallet seed phrase.
# .env is already listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required for deployment ───────────────────────────────────────────────────

# Your Midnight Preprod wallet mnemonic (12, 15, or 24 BIP39 words).
# Fund this wallet at: https://midnight-tmnight-preprod.nethermind.dev/
# Delegate tNIGHT to generate tDUST (required for gas fees).
MIDNIGHT_SEED_PHRASE=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# ── Optional overrides ────────────────────────────────────────────────────────

# Proof server URL. Defaults to public Preprod prover.
# Override with local Docker prover: http://localhost:6300
MIDNIGHT_PROVER_URL=https://prover.preprod.midnight.network

# Gas limit for the deployment transaction (in DUST microunits).
# Default: 10000000 (10 DUST). Increase if deployment reverts with out-of-gas.
MIDNIGHT_GAS_LIMIT=10000000

# Network selection. Currently only 'preprod' is supported by this project.
MIDNIGHT_NETWORK=preprod

# ── Local Docker proof server (optional) ──────────────────────────────────────
# If you run the Midnight proof server locally via Docker:
#   docker pull midnight-network/prover:latest
#   docker run -p 6300:6300 midnight-network/prover:latest
# Then set:
# MIDNIGHT_PROVER_URL=http://localhost:6300

# ── Debug ─────────────────────────────────────────────────────────────────────
# Set DEBUG=1 to print full stack traces on errors.
# DEBUG=1
